IF STATEMENT

<?php
$age = 20;

if ($age >= 18) {
    echo "You are old enough to vote.";
}
?>

IF ELSE STATEMENT

<?php
$grade = 80;

if ($grade >= 75) {
    echo "You passed the exam.";
} else {
    echo "You failed the exam.";
}
?>

IF ELSEIF ELSE STATEMENT 

<?php
$score = 92;

if ($score >= 90) {
    echo "Grade A";
} elseif ($score >= 80) {
    echo "Grade B";
} elseif ($score >= 75) {
    echo "Grade C";
} else {
    echo "Failed";
}
?>

SWITCE CASE STATEMENT

<?php
$grade = "B";

switch ($grade) {
    case "A":
        echo "Excellent!";
        break;

    case "B":
        echo "Very Good!";
        break;

    case "C":
        echo "Good!";
        break;

    case "D":
        echo "Needs Improvement.";
        break;

    default:
        echo "Invalid grade.";
}
?>

